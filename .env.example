DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty for SQLite; set for Postgres, e.g. postgres://user:pass@localhost:5432/kapid
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: store uploaded images in Cloudinary (set all three). Leave blank to save to MEDIA_ROOT.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
